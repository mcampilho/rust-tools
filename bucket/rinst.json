    "homepage": "https://github.com/mcampilho/rust-tools/tree/master/apps/rinst",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/mcampilho/rust-tools/releases/download/rinst-v0.2.1/rinst-0.2.1-windows-x86_64.zip",
            "hash": "d41c917ec6d611c6cb2e57627dc206135c990a86b05d894b699de299fbf218b7",
            "extract_dir": "rinst-0.2.1-windows-x86_64"
        }
    },
    "bin": "rinst.exe",
    "shortcuts": [
        [
            "rinst.exe",
            "rinst"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/mcampilho/rust-tools/releases",
        "regex": "\"tag_name\":\\s*\"rinst-v([\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
