    "homepage": "https://github.com/mcampilho/rust-tools/tree/master/apps/rpack",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/mcampilho/rust-tools/releases/download/rpack-v0.1.0/rpack-0.1.0-windows-x86_64.zip",
            "hash": "c1c47c301fda71bf819d5db38adc4d3fcfcb5ea0b2687bff338685b13c4288e4",
            "extract_dir": "rpack-0.1.0-windows-x86_64"
        }
    },
    "bin": "rpack.exe",
    "shortcuts": [
        [
            "rpack.exe",
            "rpack"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/mcampilho/rust-tools/releases",
